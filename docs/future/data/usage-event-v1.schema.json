{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nippan.org/schemas/usage-event-v1.schema.json",
  "title": "Nippan Immutable Usage Event v1",
  "description": "Append-only Application-attributable measurable/billable usage event used to rebuild usage/cost aggregates. Platform/tenant-scoped admin/health telemetry without application attribution is outside this ledger. Markdown Request/Trace/Usage Contract is normative for semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "usage_event_id",
    "occurred_at",
    "tenant_id",
    "application_id",
    "request_id",
    "event_type",
    "quantity",
    "unit",
    "dedupe_key",
    "source_type",
    "source_id"
  ],
  "properties": {
    "usage_event_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "channel_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "conversation_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "request",
        "ai_tokens",
        "ai_cost",
        "embedding_tokens",
        "tool_call",
        "storage_bytes",
        "queue_operation",
        "file_processing",
        "external_api_cost"
      ]
    },
    "quantity": {
      "type": "number",
      "minimum": 0
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "source_type": {
      "type": "string",
      "enum": [
        "request",
        "ai_call",
        "tool_call",
        "storage",
        "queue",
        "file",
        "external_api",
        "other"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "provider": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "tool_domain": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "tool_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 150
    },
    "provider_reported_cost": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "normalized_cost": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "pricing_rate_version": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "provider_reported_cost"
            ],
            "properties": {
              "provider_reported_cost": {
                "type": "number"
              }
            }
          },
          {
            "required": [
              "normalized_cost"
            ],
            "properties": {
              "normalized_cost": {
                "type": "number"
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "currency"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "normalized_cost"
        ],
        "properties": {
          "normalized_cost": {
            "type": "number"
          }
        }
      },
      "then": {
        "required": [
          "pricing_rate_version"
        ],
        "properties": {
          "pricing_rate_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    }
  ]
}
