{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/ling-3.0-flash-fin-free",
  "small_model": "opencode/ling-3.0-flash-fin-free",
  "default_agent": "project-lead",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "git pull*": "allow",
      "git fetch*": "allow",
      "git checkout*": "allow",
      "git switch*": "allow",
      "git stash*": "allow",
      "git show*": "allow",
      "git tag*": "allow",
      "git remote*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git grep*": "allow",
      "git config*": "allow",
      "git merge*": "allow",
      "git rebase*": "allow",
      "git cherry-pick*": "allow",
      "git restore*": "allow",
      "git mv*": "allow",
      "git rm*": "allow",
      "git describe*": "allow",
      "gh *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "python*": "allow",
      "python3*": "allow",
      "pytest*": "allow",
      "pip*": "allow",
      "pip3*": "allow",
      "psql*": "allow",
      "pg_dump*": "allow",
      "pg_restore*": "allow",
      "docker*": "allow",
      "docker-compose*": "allow",
      "supabase*": "allow",
      "Get-ChildItem*": "allow",
      "Get-Content*": "allow",
      "Get-Item*": "allow",
      "Get-Command*": "allow",
      "Get-FileHash*": "allow",
      "Get-Location*": "allow",
      "Test-Path*": "allow",
      "Select-String*": "allow",
      "Select-Object*": "allow",
      "Where-Object*": "allow",
      "Sort-Object*": "allow",
      "Measure-Object*": "allow",
      "New-Item*": "allow",
      "Set-Content*": "allow",
      "Add-Content*": "allow",
      "Copy-Item*": "allow",
      "Move-Item*": "allow",
      "Rename-Item*": "allow",
      "Remove-Item*": "allow",
      "Write-Output*": "allow",
      "Write-Host*": "allow",
      "Expand-Archive*": "allow",
      "Compress-Archive*": "allow",
      "Clear-Content*": "allow",
      "Split-Path*": "allow",
      "Join-Path*": "allow",
      "Resolve-Path*": "allow",
      "Set-Location*": "allow",
      "cd *": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --force-with-lease*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git checkout -- .*": "deny",
      "git restore .*": "deny",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "Remove-Item*Recurse*": "deny",
      "Remove-Item* -r *": "deny",
      "Remove-Item* -R *": "deny",
      "rd /s*": "deny",
      "rmdir /s*": "deny",
      "shutdown*": "deny",
      "restart-computer*": "deny",
      "stop-computer*": "deny",
      "format-volume*": "deny",
      "diskpart*": "deny",
      "clear-disk*": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "deny",
      "C:/Users/chetgo/AppData/Local/Temp/opencode/**": "allow",
      "C:/Users/chetgo/.config/opencode/**": "allow",
      "C:/Users/chetgo/.local/state/opencode/**": "allow",
      "C:/Users/chetgo/.local/share/opencode/**": "allow",
      "C:/Users/chetgo/AppData/Local/Microsoft/WinGet/Packages/SST.opencode*/**": "allow",
      "C:/Users/chetgo/AppData/Roaming/ai.opencode.desktop/**": "allow",
      "C:/Users/chetgo/AppData/Local/@opencode-aidesktop-updater/**": "allow"
    }
  },
  "agent": {
    "project-lead": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash"
    },
    "model-recruiter": {
      "model": "openrouter/openai/gpt-6-luna"
    }
  },
  "tools": {
    "n8n_create_workflow_from_code": true,
    "n8n_update_workflow": true,
    "n8n_archive_workflow": false,
    "n8n_restore_workflow_version": false,
    "n8n_publish_workflow": false,
    "n8n_unpublish_workflow": false,
    "n8n_execute_workflow": true,
    "n8n_test_workflow": false,
    "n8n_prepare_workflow_pin_data": false,
    "n8n_create_data_table": false,
    "n8n_rename_data_table": false,
    "n8n_add_data_table_column": false,
    "n8n_delete_data_table_column": false,
    "n8n_rename_data_table_column": false,
    "n8n_add_data_table_rows": false,
    "n8n_update_folder": false,
    "n8n_move_workflows_to_folder": false
  },
  "mcp": {
    "openrouter": {
      "type": "remote",
      "url": "https://mcp.openrouter.ai/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:OPENROUTER_API_KEY}"
      }
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": true
    },
    "render": {
      "type": "remote",
      "url": "https://mcp.render.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:RENDER_API_KEY}"
      }
    },
    "nippan-gateway": {
      "type": "remote",
      "url": "https://mcp.nippan.org/mcp",
      "enabled": false,
      "oauth": {}
    },
    "n8n": {
      "type": "remote",
      "url": "https://n8n.nippan.org/mcp-server/http",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:N8N_MCP_TOKEN}"
      }
    }
  }
}