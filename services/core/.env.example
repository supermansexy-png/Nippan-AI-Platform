# Nippan AI Platform — Environment Variables Example
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# ─────────────────────────────────────
# War Room — Authentication & Access
# ─────────────────────────────────────

# Dev-time API key for Bearer-token authenticated remote access.
# When set, requests with "Authorization: Bearer <key>" are accepted
# without Cloudflare Access or loopback checks.
# Must be a strong random string (recommend 64+ chars).
# Stored as SHA-256 hash server-side; compared via hmac.compare_digest.
NIPPAN_WAR_ROOM_DEV_API_KEY=

# Enable local-only access (loopback + process-bound).
# This does NOT provide network-level security. Use only when the
# service runs on a non-network-accessible host (e.g. localhost).
NIPPAN_WAR_ROOM_PREVIEW_LOCAL_ACCESS_ENABLED=false

# Enable remote preview access via Cloudflare Access JWT.
# Requires Cloudflare Access setup, JWKS endpoint, and owner email.
NIPPAN_WAR_ROOM_PREVIEW_REMOTE_ACCESS_ENABLED=false

# Cloudflare Access configuration (used when REMOTE_ACCESS_ENABLED=true)
NIPPAN_CLOUDFLARE_ACCESS_TEAM_DOMAIN=
NIPPAN_CLOUDFLARE_ACCESS_AUDIENCE=
NIPPAN_CLOUDFLARE_ACCESS_OWNER_EMAIL=
NIPPAN_CLOUDFLARE_ACCESS_JWKS_TTL_SECONDS=3600


# ─────────────────────────────────────
# Core Runtime
# ─────────────────────────────────────

# PostgreSQL connection (Set via DATABASE_URL by Supabase / Docker)
DATABASE_URL=postgresql://postgres.[DEFAULT].[PASSWORD]@localhost:5432/postgres

# Application settings
APP_ENV=development
DEBUG=true


# ─────────────────────────────────────
# Model Routing (OpenRouter)
# ─────────────────────────────────────

# OpenRouter API key (required for model calls)
OPENROUTER_API_KEY=


# ─────────────────────────────────────
# Security Notes
# ─────────────────────────────────────
# - war_room_dev_api_key is hashed with SHA-256 before comparison
#   using hmac.compare_digest() → constant-time, no timing leaks
# - Unauthenticated requests to /war-room/ return HTTP 403 (fail-closed)
# - Never expose API keys in logs, error messages, or prompts
# - Rotate keys periodically; regenerate if compromised
