# Nippan AI Platform - Compute Console Configuration
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env or secrets to git.

# Environment mode: development, test, production
COMPUTE_ENV=development

# Compute provider: mock | colab | hermes | ollama
COMPUTE_PROVIDER=mock

# Storage provider: gdrive | nas
STORAGE_PROVIDER=gdrive

# Server binding
HTTP_HOST=127.0.0.1
HTTP_PORT=8080

# Google Colab Runtime Configuration (when COMPUTE_PROVIDER=colab)
# Colab API or Tunnel Endpoint (e.g. ngrok / cloudflared / jupyter gateway)
COLAB_ENDPOINT_URL=
# Colab Auth / Kernel token (leave empty if not applicable)
COLAB_AUTH_TOKEN=

# Google Drive storage mount or folder path
GDRIVE_MODELS_PATH=gdrive:/models

# Timeout settings (in seconds)
TIMEOUT_CONNECT_SEC=15.0
TIMEOUT_LOAD_SEC=45.0
TIMEOUT_CHAT_SEC=20.0

# Mock adapter behavior (for test / dev)
MOCK_SIMULATE_LATENCY_SEC=0.5
MOCK_DEFAULT_GPU=NVIDIA Tesla T4 (16GB GDDR6)
